# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Python source and text files
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf

# Explicit binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
